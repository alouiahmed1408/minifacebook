# copy to .env and edit:   cp .env.example .env
DB_NAME=minifacebook
DB_USER=minifb
DB_PASSWORD=change_me_to_a_long_random_password

# true = create 2 demo users + posts when the DB is empty (do NOT use on a public server)
SEED_DEMO_DATA=false

# default: site on port 80. With a domain + Caddy (HTTPS) use: 127.0.0.1:8080
FRONTEND_BIND=0.0.0.0:80
